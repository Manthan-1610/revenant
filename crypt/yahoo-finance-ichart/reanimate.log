stdout: {"type":"sessionUpdate","data":{"sessionId":"sess_7e3c7691-cf5b-4736-98ab-797e44c57a9f","update":{"sessionUpdate":"tool_call_update","toolCallId":"toolu_bdrk_01NTtVDSmhge8diM4juXcAsX","status":"completed","title":"Write File","content":[{"type":"diff","path":"file:///c%3A/Users/mmant/AppData/Local/Temp/revenant-build-u2qa_gls/server.py","oldText":"","newText":"import calendar\nimport json\nfrom datetime import date\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom fastapi import FastAPI, Request\nfrom fastapi.responses import Response\n\nBASE = Path(__file__).parent\nHEADER_LINE = b\"Date,Open,High,Low,Close,Volume,Adj Close\"\n\napp = FastAPI()\n\n_index = json.loads((BASE / \"donor\" / \"index.json\").read_text(encoding=\"utf-8\"))\n_entries = _index.get(\"entries\", _index)\n_404_BODY = (BASE / \"error-404.html\").read_bytes()\n\n_donors = {}\nfor _sym, _entry in _entries.items():\n    _raw = (BASE / \"donor\" / _entry[\"file\"]).read_bytes()\n    _rows = []\n    for _line in _raw.split(b\"\\n\"):\n        _field = _line.split(b\",\", 1)[0].strip()\n        try:\n            _d = date.fromisoformat(_field.decode(\"ascii\"))\n        except Exception:\n            continue\n        _rows.append((_d, _line))\n    _donors[_sym] = _rows\n\n\ndef _donor_header(symbol: Optional[str]) -> str:\n    entry = _entries.get(symbol) if symbol else None\n    if entry is None:\n        return \"none\"\n    return \"wayback:%s/%s\" % (entry[\"host\"], entry[\"served_timestamp\"])\n\n\ndef _not_found(symbol: Optional[str], note: Optional[str] = None) -> Response:\n    headers = {\"X-Revenant-Donor\": _donor_header(symbol)}\n    if note:\n        headers[\"X-Revenant-Note\"] = note\n    return Response(\n        content=_404_BODY,\n        status_code=404,\n        media_type=\"text/html\",\n        headers=headers,\n    )\n\n\ndef _to_int(value: Optional[str]) -> Optional[int]:\n    if value is None:\n        return None\n    try:\n        return int(value)\n    except Exception:\n        return None\n\n\ndef _resolve(params, month_key, day_key, year_key) -> Optional[date]:\n    m = _to_int(params.get(month_key))\n    d = _to_int(params.get(day_key))\n    y = _to_int(params.get(year_key))\n    if m is None or d is None or y is None:\n        return None\n    year = y + m // 12\n    month = m % 12 + 1\n    if year < 1 or year > 9999:\n        return None\n    dim = calendar.monthrange(year, month)[1]\n    day = min(max(d, 1), dim)\n    return date(year, month, day)\n\n\n@app.get(\"/table.csv\")\nasync def table_csv(request: Request):\n    params = request.query_params\n    g = params.get(\"g\")\n    s = params.get(\"s\")\n\n    if g:\n        if g != \"d\":\n            return _not_found(\n                s if s in _entries else None,\n                \"interval %s is not reanimated yet\" % g,\n            )\n\n    if not s or s not in _entries:\n        return _not_found(None)\n\n    rows = _donors[s]\n    if not rows:\n        return _not_found(s)\n\n    dates = [r[0] for r in rows]\n    start = _resolve(params, \"a\", \"b\", \"c\") or min(dates)\n    end = _resolve(params, \"d\", \"e\", \"f\") or max(dates)\n\n    kept = [line for d, line in rows if start <= d <= end]\n    if not kept:\n        return _not_found(s)\n\n    body = HEADER_LINE + b\"\\n\" + b\"\\n\".join(kept) + b\"\\n\"\n    return Response(\n        content=body,\n        status_code=200,\n        media_type=\"text/csv\",\n        headers={\"X-Revenant-Donor\": _donor_header(s)},\n    )\n"}],"locations":[{"path":"c:\\Users\\mmant\\AppData\\Local\\Temp\\revenant-build-u2qa_gls\\server.py"}],"rawInput":{"path":"C:\\Users\\mmant\\AppData\\Local\\Temp\\revenant-build-u2qa_gls\\server.py","text":"import calendar\nimport json\nfrom datetime import date\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom fastapi import FastAPI, Request\nfrom fastapi.responses import Response\n\nBASE = Path(__file__).parent\nHEADER_LINE = b\"Date,Open,High,Low,Close,Volume,Adj Close\"\n\napp = FastAPI()\n\n_index = json.loads((BASE / \"donor\" / \"index.json\").read_text(encoding=\"utf-8\"))\n_entries = _index.get(\"entries\", _index)\n_404_BODY = (BASE / \"error-404.html\").read_bytes()\n\n_donors = {}\nfor _sym, _entry in _entries.items():\n    _raw = (BASE / \"donor\" / _entry[\"file\"]).read_bytes()\n    _rows = []\n    for _line in _raw.split(b\"\\n\"):\n        _field = _line.split(b\",\", 1)[0].strip()\n        try:\n            _d = date.fromisoformat(_field.decode(\"ascii\"))\n        except Exception:\n            continue\n        _rows.append((_d, _line))\n    _donors[_sym] = _rows\n\n\ndef _donor_header(symbol: Optional[str]) -> str:\n    entry = _entries.get(symbol) if symbol else None\n    if entry is None:\n        return \"none\"\n    return \"wayback:%s/%s\" % (entry[\"host\"], entry[\"served_timestamp\"])\n\n\ndef _not_found(symbol: Optional[str], note: Optional[str] = None) -> Response:\n    headers = {\"X-Revenant-Donor\": _donor_header(symbol)}\n    if note:\n        headers[\"X-Revenant-Note\"] = note\n    return Response(\n        content=_404_BODY,\n        status_code=404,\n        media_type=\"text/html\",\n        headers=headers,\n    )\n\n\ndef _to_int(value: Optional[str]) -> Optional[int]:\n    if value is None:\n        return None\n    try:\n        return int(value)\n    except Exception:\n        return None\n\n\ndef _resolve(params, month_key, day_key, year_key) -> Optional[date]:\n    m = _to_int(params.get(month_key))\n    d = _to_int(params.get(day_key))\n    y = _to_int(params.get(year_key))\n    if m is None or d is None or y is None:\n        return None\n    year = y + m // 12\n    month = m % 12 + 1\n    if year < 1 or year > 9999:\n        return None\n    dim = calendar.monthrange(year, month)[1]\n    day = min(max(d, 1), dim)\n    return date(year, month, day)\n\n\n@app.get(\"/table.csv\")\nasync def table_csv(request: Request):\n    params = request.query_params\n    g = params.get(\"g\")\n    s = params.get(\"s\")\n\n    if g:\n        if g != \"d\":\n            return _not_found(\n                s if s in _entries else None,\n                \"interval %s is not reanimated yet\" % g,\n            )\n\n    if not s or s not in _entries:\n        return _not_found(None)\n\n    rows = _donors[s]\n    if not rows:\n        return _not_found(s)\n\n    dates = [r[0] for r in rows]\n    start = _resolve(params, \"a\", \"b\", \"c\") or min(dates)\n    end = _resolve(params, \"d\", \"e\", \"f\") or max(dates)\n\n    kept = [line for d, line in rows if start <= d <= end]\n    if not kept:\n        return _not_found(s)\n\n    body = HEADER_LINE + b\"\\n\" + b\"\\n\".join(kept) + b\"\\n\"\n    return Response(\n        content=body,\n        status_code=200,\n        media_type=\"text/csv\",\n        headers={\"X-Revenant-Donor\": _donor_header(s)},\n    )\n"},"rawOutput":{"message":"Created the C:\\Users\\mmant\\AppData\\Local\\Temp\\revenant-build-u2qa_gls\\server.py file."},"_meta":{"kiro":{"toolOrigin":"default","checkpoint":{"modified":"kiro-snapshot-v2://sess_7e3c7691-cf5b-4736-98ab-797e44c57a9f:064556e5/?originalPath%3Dserver.py","local":"file:///c%3A/Users/mmant/AppData/Local/Temp/revenant-build-u2qa_gls/server.py"}}}}}}
